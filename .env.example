# Cloudflare R2. Needed on the server (Dokploy → Environment) and locally for `npm run photos:upload`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only if the bucket was created with the EU jurisdiction. Just the code, no URL.
# R2_JURISDICTION=eu
R2_BUCKET=mathisheck-photos
# Public URL of the bucket (custom domain or r2.dev URL), no trailing slash
R2_PUBLIC_URL=https://images.mathisheck.de

# Password for /admin (any user name)
ADMIN_PASSWORD=
