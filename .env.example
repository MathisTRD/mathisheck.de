# Cloudflare R2. Needed on the server (Dokploy → Environment) and locally for `npm run photos:upload`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only if the buckets were created with the EU jurisdiction. Just the code, no URL.
# R2_JURISDICTION=eu
# Public bucket with the converted images
R2_BUCKET=mathisheck-photos
# Separate PRIVATE bucket (no public access) for the untouched originals
R2_ORIGINALS_BUCKET=mathisheck-originals
# Public URL of R2_BUCKET (custom domain or r2.dev URL), no trailing slash
R2_PUBLIC_URL=https://images.mathisheck.de

# Cloudflare Access protecting /admin and /api/admin (server only)
# Team domain from Zero Trust → Settings, e.g. mathisheck.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# "Application Audience (AUD) Tag" of the Access application
CF_ACCESS_AUD=
# Comma-separated emails allowed into /admin (must also be allowed by the Access policy)
ADMIN_EMAILS=

# Umami analytics (optional, server only). Leave empty to disable tracking.
# Full URL of the tracker script, e.g. https://stats.mathisheck.de/script.js
UMAMI_SCRIPT_URL=
# "Website ID" from Umami → Settings → Websites
UMAMI_WEBSITE_ID=
