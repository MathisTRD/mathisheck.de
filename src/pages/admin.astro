---
import series from '../data/series.json';
import { getManifest, store } from '../lib/manifest';
import { photoUrl, photosInFolder, getCover } from '../lib/photos';

export const prerender = false;

const manifest = await getManifest();
const groups = [
	...series.map((s) => ({ folder: s.folder, slug: s.slug, title: s.title })),
	{ folder: 'cover', slug: '', title: 'Cover' },
];
const coverOf = Object.fromEntries(series.map((s) => [s.slug, getCover(manifest, s)]));
const thumb = (photo: (typeof manifest.photos)[number]) => photoUrl(manifest.baseUrl, photo, photo.widths[0], 'webp');

Astro.response.headers.set('Cache-Control', 'no-store');
---

<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>Fotos verwalten | Mathis Heck</title>
		<style>
			:root { font-family: system-ui, sans-serif; background: #f7f7f4; color: #111; }
			body { margin: 0 auto; max-width: 1100px; padding: 1.5rem 1rem 4rem; }
			h1 { font-size: 1.6rem; margin: 0 0 1rem; }
			.warn { background: #fde8e8; padding: 0.75rem 1rem; border-radius: 8px; }
			.tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; }
			.tabs button { border: 1px solid #111; background: transparent; border-radius: 999px; padding: 0.4rem 0.9rem; cursor: pointer; font: inherit; }
			.tabs button[aria-pressed='true'] { background: #111; color: #fff; }
			.drop { display: block; margin-bottom: 0.5rem; border: 2px dashed #999; border-radius: 12px; padding: 2rem 1rem; text-align: center; cursor: pointer; background: #fff; }
			.drop.over { border-color: #111; background: #eee; }
			.queue { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: 0.25rem; font-size: 0.9rem; }
			.queue .err { color: #b00020; }
			.queue .ok { color: #1b7f3b; }
			.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 0.75rem; margin-top: 1.5rem; }
			.card { background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
			.card img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
			.card.is-cover { outline: 3px solid #111; }
			.card .actions { display: flex; gap: 0.25rem; padding: 0.4rem; }
			.card button { flex: 1; font: inherit; font-size: 0.8rem; padding: 0.3rem; border: 1px solid #ccc; background: #fafafa; border-radius: 6px; cursor: pointer; }
			.card button.delete:hover { background: #fde8e8; border-color: #b00020; }
			.card .name { font-size: 0.7rem; color: #666; padding: 0 0.4rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			[hidden] { display: none !important; }
		</style>
	</head>
	<body>
		<h1>Fotos verwalten</h1>
		{!store && <p class="warn">R2 ist auf dem Server nicht konfiguriert. Hochladen und Löschen sind deaktiviert.</p>}

		<div class="tabs" role="group" aria-label="Serie">
			{groups.map((g, i) => (
				<button type="button" data-tab={g.folder} aria-pressed={i === 0 ? 'true' : 'false'}>
					{g.title} ({photosInFolder(manifest, g.folder).length})
				</button>
			))}
		</div>

		<label class="drop" id="drop">
			<input id="file" type="file" accept="image/*" multiple hidden />
			Fotos hierher ziehen oder klicken, um sie zu <strong id="target">{groups[0].title}</strong> hinzuzufügen
		</label>
		<ul class="queue" id="queue"></ul>

		{groups.map((g, i) => (
			<section class="grid" data-panel={g.folder} hidden={i !== 0}>
				{photosInFolder(manifest, g.folder).map((photo) => (
					<div class={`card ${g.slug && coverOf[g.slug] === photo ? 'is-cover' : ''}`}>
						<img src={thumb(photo)} alt={photo.name} loading="lazy" />
						<div class="name" title={photo.name}>{photo.name}</div>
						<div class="actions">
							{g.slug && (
								<button type="button" data-cover={g.slug} data-folder={photo.folder} data-name={photo.name}>
									Als Cover
								</button>
							)}
							<button type="button" class="delete" data-delete data-folder={photo.folder} data-name={photo.name}>
								Löschen
							</button>
						</div>
					</div>
				))}
			</section>
		))}

		<script is:inline define:vars={{ titles: Object.fromEntries(groups.map((g) => [g.folder, g.title])) }}>
			let folder = Object.keys(titles)[0];
			const drop = document.getElementById('drop');
			const input = document.getElementById('file');
			const queue = document.getElementById('queue');
			const headers = { 'x-admin': '1' };

			document.querySelectorAll('[data-tab]').forEach((tab) => {
				tab.addEventListener('click', () => {
					folder = tab.dataset.tab;
					document.querySelectorAll('[data-tab]').forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
					document.querySelectorAll('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== folder));
					document.getElementById('target').textContent = titles[folder];
					history.replaceState(null, '', `#${folder}`);
				});
			});
			document.querySelector(`[data-tab="${CSS.escape(location.hash.slice(1))}"]`)?.click();

			const upload = async (files) => {
				const target = folder;
				let uploaded = 0;
				for (const file of files) {
					const row = document.createElement('li');
					row.textContent = `${file.name}: wird konvertiert und hochgeladen …`;
					queue.append(row);
					const body = new FormData();
					body.append('folder', target);
					body.append('file', file);
					try {
						const res = await fetch('/api/admin/photos', { method: 'POST', headers, body });
						const data = await res.json().catch(() => ({}));
						if (!res.ok) throw new Error(data.error || res.statusText);
						row.textContent = `${file.name}: fertig`;
						row.className = 'ok';
						uploaded++;
					} catch (e) {
						row.textContent = `${file.name}: Fehler – ${e.message}`;
						row.className = 'err';
					}
				}
				if (uploaded === files.length) location.reload();
			};

			input.addEventListener('change', () => input.files.length && upload([...input.files]));
			drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
			drop.addEventListener('dragleave', () => drop.classList.remove('over'));
			drop.addEventListener('drop', (e) => {
				e.preventDefault();
				drop.classList.remove('over');
				const files = [...e.dataTransfer.files].filter((f) => f.type.startsWith('image/'));
				if (files.length) upload(files);
			});

			const send = async (url, method, payload) => {
				const res = await fetch(url, { method, headers: { ...headers, 'content-type': 'application/json' }, body: JSON.stringify(payload) });
				if (!res.ok) {
					const data = await res.json().catch(() => ({}));
					alert(data.error || res.statusText);
					return;
				}
				location.reload();
			};

			document.querySelectorAll('[data-delete]').forEach((button) => {
				button.addEventListener('click', () => {
					if (confirm(`${button.dataset.name} wirklich löschen?`)) {
						send('/api/admin/photos', 'DELETE', { folder: button.dataset.folder, name: button.dataset.name });
					}
				});
			});
			document.querySelectorAll('[data-cover]').forEach((button) => {
				button.addEventListener('click', () =>
					send('/api/admin/cover', 'POST', { slug: button.dataset.cover, folder: button.dataset.folder, name: button.dataset.name })
				);
			});
		</script>
	</body>
</html>
