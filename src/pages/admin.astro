---
import { getManifest, store } from '../lib/manifest';
import { photoUrl, subjectOf, subjects, tags, tagsOf } from '../lib/photos';

const manifest = await getManifest();
const photos = [...manifest.photos].sort((a, b) => a.name.localeCompare(b.name));
const views = [
	{ key: 'all', title: 'Alle', count: photos.length },
	{ key: 'none', title: 'Ohne Motiv', count: photos.filter((p) => !subjectOf(p)).length },
	...subjects.map((s) => ({ key: s.slug, title: s.title, count: photos.filter((p) => subjectOf(p) === s.slug).length })),
];
const thumb = (photo: (typeof manifest.photos)[number]) => photoUrl(manifest.baseUrl, photo, photo.widths[0], 'webp');

Astro.response.headers.set('Cache-Control', 'no-store');
---

<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>Fotos verwalten | Mathis Heck</title>
		<style>
			:root { font-family: system-ui, sans-serif; background: #f7f7f4; color: #111; }
			body { margin: 0 auto; max-width: 1100px; padding: 1.5rem 1rem 4rem; }
			h1 { font-size: 1.6rem; margin: 0; }
			h2 { font-size: 1rem; margin: 2rem 0 0.75rem; }
			.top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.5rem; margin-bottom: 1rem; font-size: 0.9rem; }
			.top a { color: inherit; }
			.warn { background: #fde8e8; padding: 0.75rem 1rem; border-radius: 8px; }
			.hint { color: #666; font-size: 0.9rem; margin: 0 0 0.75rem; }
			.upload-options { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-bottom: 0.75rem; font-size: 0.9rem; }
			select { font: inherit; padding: 0.3rem 0.4rem; border: 1px solid #ccc; border-radius: 6px; background: #fff; }
			.tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; }
			.tabs button { border: 1px solid #111; background: transparent; border-radius: 999px; padding: 0.4rem 0.9rem; cursor: pointer; font: inherit; }
			.tabs button[aria-pressed='true'] { background: #111; color: #fff; }
			.drop { display: block; margin-bottom: 0.5rem; border: 2px dashed #999; border-radius: 12px; padding: 2rem 1rem; text-align: center; cursor: pointer; background: #fff; }
			.drop.over { border-color: #111; background: #eee; }
			.queue { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: 0.25rem; font-size: 0.9rem; }
			.queue .err, .card .status.err { color: #b00020; }
			.queue .ok, .card .status.ok { color: #1b7f3b; }
			.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.75rem; margin-top: 1.25rem; }
			.card { background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); display: flex; flex-direction: column; }
			.card.no-subject { outline: 2px solid #e0a100; }
			.card img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
			.card .fields { display: grid; gap: 0.35rem; padding: 0.5rem; font-size: 0.85rem; }
			.card .fields select { width: 100%; }
			.card .tags { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; }
			.card .status { min-height: 1em; font-size: 0.75rem; color: #666; }
			.card .bottom { display: flex; align-items: center; gap: 0.25rem; margin-top: auto; padding: 0 0.5rem 0.5rem; }
			.card .name { flex: 1; font-size: 0.7rem; color: #666; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.card button { font: inherit; font-size: 0.8rem; padding: 0.3rem 0.6rem; border: 1px solid #ccc; background: #fafafa; border-radius: 6px; cursor: pointer; }
			.card button:hover { background: #fde8e8; border-color: #b00020; }
			label { cursor: pointer; }
			[hidden] { display: none !important; }
		</style>
	</head>
	<body>
		<header class="top">
			<h1>Fotos verwalten</h1>
			<span>{Astro.locals.adminEmail} · <a href="/cdn-cgi/access/logout">Abmelden</a></span>
		</header>
		{!store && <p class="warn">R2 ist auf dem Server nicht konfiguriert. Hochladen, Bearbeiten und Löschen sind deaktiviert.</p>}

		<h2>Hochladen</h2>
		<div class="upload-options">
			<label>Motiv
				<select id="upload-subject">
					{subjects.map((s) => <option value={s.slug}>{s.title}</option>)}
				</select>
			</label>
			{tags.map((t) => (
				<label><input type="checkbox" name="upload-tag" value={t.slug} /> {t.title}</label>
			))}
		</div>
		<label class="drop" id="drop">
			<input id="file" type="file" accept="image/*" multiple hidden />
			Fotos hierher ziehen oder klicken, um sie hochzuladen
		</label>
		<ul class="queue" id="queue"></ul>

		<h2>Fotos</h2>
		<p class="hint">Änderungen an Motiv und Tags werden sofort gespeichert. Fotos ohne Motiv und ohne Tag erscheinen nicht in der Galerie.</p>
		<div class="tabs" role="group" aria-label="Ansicht">
			{views.map((v, i) => (
				<button type="button" data-view={v.key} aria-pressed={i === 0 ? 'true' : 'false'}>
					{v.title} (<span data-count={v.key}>{v.count}</span>)
				</button>
			))}
		</div>

		<section class="grid">
			{photos.map((photo) => (
				<div
					class={`card ${subjectOf(photo) ? '' : 'no-subject'}`}
					data-card
					data-folder={photo.folder}
					data-name={photo.name}
					data-subject={subjectOf(photo) ?? ''}
				>
					<img src={thumb(photo)} alt={photo.name} loading="lazy" />
					<div class="fields">
						<select data-subject-select aria-label="Motiv">
							<option value="">Kein Motiv</option>
							{subjects.map((s) => <option value={s.slug} selected={subjectOf(photo) === s.slug}>{s.title}</option>)}
						</select>
						<div class="tags">
							{tags.map((t) => (
								<label><input type="checkbox" data-tag value={t.slug} checked={tagsOf(photo).includes(t.slug)} /> {t.title}</label>
							))}
						</div>
						<span class="status" data-status></span>
					</div>
					<div class="bottom">
						<span class="name" title={photo.name}>{photo.name}</span>
						<button type="button" data-delete>Löschen</button>
					</div>
				</div>
			))}
		</section>

		<script is:inline>
			const headers = { 'x-admin': '1' };
			const cards = [...document.querySelectorAll('[data-card]')];

			// Views
			let view = 'all';
			const showView = (key) => {
				view = key;
				document.querySelectorAll('[data-view]').forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.view === key)));
				cards.forEach((card) => {
					const subject = card.dataset.subject;
					card.hidden = !(key === 'all' || (key === 'none' ? !subject : subject === key));
				});
				history.replaceState(null, '', key === 'all' ? location.pathname : `#${key}`);
			};
			const updateCounts = () => {
				document.querySelectorAll('[data-count]').forEach((el) => {
					const key = el.dataset.count;
					el.textContent = cards.filter((c) => key === 'all' || (key === 'none' ? !c.dataset.subject : c.dataset.subject === key)).length;
				});
			};
			document.querySelectorAll('[data-view]').forEach((tab) => tab.addEventListener('click', () => showView(tab.dataset.view)));
			if (document.querySelector(`[data-view="${CSS.escape(location.hash.slice(1))}"]`)) showView(location.hash.slice(1));

			// Subject and tags, saved on every change
			cards.forEach((card) => {
				const select = card.querySelector('[data-subject-select]');
				const boxes = [...card.querySelectorAll('[data-tag]')];
				const status = card.querySelector('[data-status]');
				const save = async () => {
					status.textContent = 'Speichert …';
					status.className = 'status';
					const payload = {
						folder: card.dataset.folder,
						name: card.dataset.name,
						subject: select.value || null,
						tags: boxes.filter((b) => b.checked).map((b) => b.value),
					};
					try {
						const res = await fetch('/api/admin/photos', {
							method: 'PATCH',
							headers: { ...headers, 'content-type': 'application/json' },
							body: JSON.stringify(payload),
						});
						const data = await res.json().catch(() => ({}));
						if (!res.ok) throw new Error(data.error || res.statusText);
						card.dataset.subject = select.value;
						card.classList.toggle('no-subject', !select.value);
						updateCounts();
						status.textContent = 'Gespeichert';
						status.className = 'status ok';
					} catch (e) {
						status.textContent = `Fehler – ${e.message}`;
						status.className = 'status err';
					}
				};
				select.addEventListener('change', save);
				boxes.forEach((box) => box.addEventListener('change', save));

				card.querySelector('[data-delete]').addEventListener('click', async () => {
					if (!confirm(`${card.dataset.name} wirklich löschen?`)) return;
					const res = await fetch('/api/admin/photos', {
						method: 'DELETE',
						headers: { ...headers, 'content-type': 'application/json' },
						body: JSON.stringify({ folder: card.dataset.folder, name: card.dataset.name }),
					});
					if (!res.ok) {
						const data = await res.json().catch(() => ({}));
						alert(data.error || res.statusText);
						return;
					}
					card.remove();
					cards.splice(cards.indexOf(card), 1);
					updateCounts();
				});
			});

			// Upload
			const drop = document.getElementById('drop');
			const input = document.getElementById('file');
			const queue = document.getElementById('queue');
			const upload = async (files) => {
				const subject = document.getElementById('upload-subject').value;
				const tags = [...document.querySelectorAll('[name="upload-tag"]:checked')].map((b) => b.value);
				let uploaded = 0;
				for (const file of files) {
					const row = document.createElement('li');
					row.textContent = `${file.name}: wird konvertiert und hochgeladen …`;
					queue.append(row);
					const body = new FormData();
					body.append('subject', subject);
					tags.forEach((tag) => body.append('tag', tag));
					body.append('file', file);
					try {
						const res = await fetch('/api/admin/photos', { method: 'POST', headers, body });
						const data = await res.json().catch(() => ({}));
						if (!res.ok) throw new Error(data.error || res.statusText);
						row.textContent = `${file.name}: fertig`;
						row.className = 'ok';
						uploaded++;
					} catch (e) {
						row.textContent = `${file.name}: Fehler – ${e.message}`;
						row.className = 'err';
					}
				}
				if (uploaded === files.length) location.reload();
			};

			input.addEventListener('change', () => input.files.length && upload([...input.files]));
			drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
			drop.addEventListener('dragleave', () => drop.classList.remove('over'));
			drop.addEventListener('drop', (e) => {
				e.preventDefault();
				drop.classList.remove('over');
				const files = [...e.dataTransfer.files].filter((f) => f.type.startsWith('image/'));
				if (files.length) upload(files);
			});
		</script>
	</body>
</html>
