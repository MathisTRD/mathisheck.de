---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Impressum | Mathis Heck" description="Impressum von Mathis Heck">
	<section class="hero-split" aria-label="Impressum">
		<div class="page-intro">
			<p class="eyebrow fade-item" style="--i:0">Impressum</p>
			<h1 class="page-title fade-item" style="--i:1">Rechtliche Angaben.</h1>
			<p class="lead fade-item" style="--i:2">
				Hier stehen die Anbieter- und Kontaktdaten für diese Website.
			</p>
		</div>

		<div class="info-list" aria-label="Angaben">
			<div class="info-block fade-item" style="--i:3">
				<p class="eyebrow">Anbieter</p>
				<p class="info-text">
					Mathis Heck<br />
					54292 Trier
				</p>
			</div>

			<div class="info-block fade-item" style="--i:4">
				<p class="eyebrow">Kontakt</p>
				<p class="info-text">
					Telefon: +49 01520 2833263<br />
					E-Mail: <a href="mailto:kontakt@mathisheck.de">kontakt@mathisheck.de</a><br />
					Website: <a href="https://www.mathisheck.de" target="_blank" rel="noreferrer">www.mathisheck.de</a>
				</p>
			</div>

			<div class="info-block fade-item" style="--i:5">
				<p class="eyebrow">Datenschutz</p>
				<p class="info-text">
					<a href="/datenschutz">Datenschutzerklärung</a>
				</p>
			</div>
		</div>
	</section>
</BaseLayout>
