---
import BaseLayout from '../layouts/BaseLayout.astro';
import R2Picture from '../components/R2Picture.astro';
import series from '../data/series.json';
import { getManifest } from '../lib/manifest';
import { getCover } from '../lib/photos';

const manifest = await getManifest();
const covers = series.map((s) => getCover(manifest, s));

---

<BaseLayout title="Bilder | Mathis Heck" description="Ausgewählte Fotoserien von Mathis Heck">
	<section class="images-page" aria-label="Ausgewählte Arbeiten">
		<header class="page-intro">
			<p class="eyebrow">Bilder</p>
			<h1 class="page-title">Ausgewählte Serien.</h1>
		</header>

		<section class="work" aria-label="Serienübersicht">
			{series.map((s, i) => (
				<article class={`work-item ${i % 2 === 1 ? 'work-item--reverse' : ''}`} data-slug={s.slug}>
					<div class="img-wrap">
						<a class="series-cover-link" href={`/images/${s.slug}`} aria-label={`Serie ${s.title} öffnen`}>
{covers[i] && (
							<R2Picture
								photo={covers[i]}
								baseUrl={manifest.baseUrl}
								class={`series-cover ${s.slug === 'astro' ? 'series-cover--astro' : ''}`}
								alt={`Titelbild der Serie ${s.title}`}
								sizes="(min-width: 900px) 50vw, 100vw"
								loading={i === 0 ? 'eager' : 'lazy'}
								decoding="auto"
								fetchpriority={i === 0 ? 'high' : 'low'}
							/>
							)}
						</a>
					</div>
					<div class="series-meta">
						<h2>{s.title}</h2>
						<p>{s.description}</p>
						<a href={`/images/${s.slug}`} class="button">Serie ansehen →</a>
					</div>
				</article>
			))}
		</section>
	</section>

</BaseLayout>
