---
import BaseLayout from '../layouts/BaseLayout.astro';
import R2Picture from '../components/R2Picture.astro';
import series from '../data/series.json';
import { getManifest } from '../lib/manifest';
import { getCover } from '../lib/photos';

export const prerender = false;

const manifest = await getManifest();
const covers = series.map((s) => getCover(manifest, s));

---

<BaseLayout title="Images | Mathis Heck" description="Selected photography series by Mathis Heck">
	<section class="images-page" aria-label="Selected work">
		<header class="images-header">
			<p class="eyebrow">Images</p>
			<h1 class="series-placeholder-title">Selected series.</h1>
		</header>

		<section class="work" aria-label="Series overview">
			{series.map((s, i) => (
				<article class={`work-item ${i % 2 === 1 ? 'work-item--reverse' : ''}`} data-slug={s.slug}>
					<div class="img-wrap">
						<a class="series-cover-link" href={`/images/${s.slug}`} aria-label={`Open ${s.title} series`}>
{covers[i] && (
							<R2Picture
								photo={covers[i]}
								baseUrl={manifest.baseUrl}
								class={`series-cover ${s.slug === 'astro' ? 'series-cover--astro' : ''}`}
								alt={`${s.title} cover`}
								sizes="(min-width: 900px) 50vw, 100vw"
								loading={i === 0 ? 'eager' : 'lazy'}
								decoding="auto"
								fetchpriority={i === 0 ? 'high' : 'low'}
							/>
							)}
						</a>
					</div>
					<div class="series-meta">
						<h2>{s.title}</h2>
						<p>{s.description}</p>
						<a href={`/images/${s.slug}`} class="series-link">View series →</a>
					</div>
				</article>
			))}
		</section>
	</section>

		<style is:inline>
			.images-page .fade-item,
			.images-page .reveal-on-scroll,
			.images-page .work-item,
			.images-page .series-cover,
			.images-page .series-meta {
				opacity: 1 !important;
				transform: none !important;
				filter: none !important;
				animation: none !important;
				transition: none !important;
			}
		</style>
</BaseLayout>
