---
import BaseLayout from '../../layouts/BaseLayout.astro';
import series from '../../data/series.json';
import R2Picture from '../../components/R2Picture.astro';
import { getManifest } from '../../lib/manifest';
import { photosInFolder } from '../../lib/photos';

const item = series.find((s) => s.slug === Astro.params.slug);
if (!item) return new Response(null, { status: 404 });

const manifest = await getManifest();
const images = photosInFolder(manifest, item.folder);
---

<BaseLayout title={`${item.title} | Mathis Heck`} description={item.description}>
	<section class="series-page" aria-label={item.title}>
		<header class="page-intro fade-item" style="--i:0">
			<p class="eyebrow">Images</p>
			<h1 class="page-title">{item.title}</h1>
		</header>

		<section class="series-gallery series-gallery--local" aria-label={`${item.title} gallery`}>
			{images.map((image, index) => (
				<button
					class="series-gallery-trigger fade-item"
					type="button"
					data-lightbox-trigger={index}
					style={`--i:${index + 1};`}
					aria-label={`Open ${item.title} image ${index + 1}`}
				>
					<R2Picture
						photo={image}
						baseUrl={manifest.baseUrl}
						alt={`${item.title} image ${index + 1}`}
						maxWidth={1280}
						sizes="(min-width: 900px) 33vw, 100vw"
						loading={index === 0 ? 'eager' : 'lazy'}
					/>
				</button>
			))}
		</section>


		<a class="button button--back fade-item" style={`--i:${Math.max(3, images.length + 2)}`} href="/images">Back to images</a>

		{images.length > 0 ? (
			<div class="lightbox" data-lightbox hidden aria-hidden="true">
				<button class="lightbox-backdrop" type="button" data-lightbox-close aria-label="Close lightbox"></button>
				<div class="lightbox-shell" role="presentation">
					<button class="lightbox-zone lightbox-zone--prev" type="button" data-lightbox-prev aria-label="Previous image"></button>
					<div class="lightbox-stage" aria-label={`${item.title} enlarged image`}>
						{images.map((image, index) => (
							<figure class="lightbox-item" data-lightbox-item={index} hidden={index !== 0}>
								<R2Picture
									photo={image}
									baseUrl={manifest.baseUrl}
									alt={`${item.title} image ${index + 1}`}
									sizes="100vw"
									loading="eager"
								/>
							</figure>
						))}
					</div>
					<button class="lightbox-zone lightbox-zone--next" type="button" data-lightbox-next aria-label="Next image"></button>
				</div>
			</div>
		) : null}
	</section>

	<style is:inline>
		.lightbox-stage {
			position: relative;
			width: fit-content;
			height: fit-content;
			max-width: 92vw;
			max-height: 88vh;
		}
		.lightbox-item {
			margin: 0;
			display: none;
			align-items: center;
			justify-content: center;
			width: auto;
			height: auto;
			max-width: 92vw;
			max-height: 88vh;
			background: transparent;
			box-shadow: none;
			border-radius: 0;
			overflow: visible;
		}
		.lightbox-item img { display: block; max-width: 92vw; max-height: 88vh; width: auto; height: auto; }
		.lightbox-item.is-active { display: flex; pointer-events: auto; }
		.lightbox-shell {
			position: relative;
			z-index: 1;
			display: inline-flex;
			width: fit-content;
			height: fit-content;
			align-items: center;
			justify-content: center;
			pointer-events: none;
		}
		.lightbox-zone {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
		}
		.lightbox-zone--prev {
			left: 0;
			transform: translate(calc(-100% - 0.75rem), -50%);
			margin-right: 0;
		}
		.lightbox-zone--next {
			right: 0;
			transform: translate(calc(100% + 0.75rem), -50%);
			margin-left: 0;
		}
	</style>

	<script is:inline>
		const root = document.querySelector('[data-lightbox]');
		const triggers = document.querySelectorAll('[data-lightbox-trigger]');
		if (root && triggers.length) {
			const items = Array.from(root.querySelectorAll('[data-lightbox-item]'));
			const prevButton = root.querySelector('[data-lightbox-prev]');
			const nextButton = root.querySelector('[data-lightbox-next]');
			let currentIndex = 0;

			const activateItem = (index) => {
				const nextIndex = (index + items.length) % items.length;
				items.forEach((item, itemIndex) => {
					const isActive = itemIndex === nextIndex;
					item.hidden = !isActive;
					item.classList.toggle('is-active', isActive);
				});
				currentIndex = nextIndex;
			};

			const showItem = (index) => {
				activateItem(index);
			};

			const openLightbox = (index) => {
				showItem(index);
				root.hidden = false;
				root.setAttribute('aria-hidden', 'false');
				document.body.classList.add('lightbox-open');
				prevButton?.focus();
			};

			const closeLightbox = () => {
				root.hidden = true;
				root.setAttribute('aria-hidden', 'true');
				document.body.classList.remove('lightbox-open');
			};

			triggers.forEach((trigger) => {
				trigger.addEventListener('click', () => {
					const index = Number(trigger.getAttribute('data-lightbox-trigger') || '0');
					openLightbox(index);
				});
			});

			prevButton?.addEventListener('click', () => showItem(currentIndex - 1));
			nextButton?.addEventListener('click', () => showItem(currentIndex + 1));

			root.addEventListener('click', (event) => {
				const target = event.target;
				if (!(target instanceof Element)) return;
				if (target.closest('[data-lightbox-prev]') || target.closest('[data-lightbox-next]')) return;
				closeLightbox();
			});

			document.addEventListener('keydown', (event) => {
				if (root.hidden) return;
				if (event.key === 'Escape') closeLightbox();
				if (event.key === 'ArrowLeft') showItem(currentIndex - 1);
				if (event.key === 'ArrowRight') showItem(currentIndex + 1);
			});

			// basic touch swipe handling
			let touchStartX = 0;
			root.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].clientX; }, { passive: true });
			root.addEventListener('touchend', (e) => {
				const dx = e.changedTouches[0].clientX - touchStartX;
				if (Math.abs(dx) > 40) {
					if (dx > 0) showItem(currentIndex - 1); else showItem(currentIndex + 1);
				}
			}, { passive: true });
		}
	</script>
</BaseLayout>