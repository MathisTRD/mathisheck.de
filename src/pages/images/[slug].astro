---
// The old series pages now live as filters of the single gallery on /images.
const filters: Record<string, string> = {
	street: 'motiv=street',
	concerts: 'motiv=concert',
	astro: 'motiv=astro',
	blackandwhite: 'tag=bw',
	color: 'tag=color',
};
const filter = filters[Astro.params.slug ?? ''];
return filter ? Astro.redirect(`/images?${filter}`, 301) : new Response(null, { status: 404 });
---
