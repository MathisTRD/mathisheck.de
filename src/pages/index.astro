---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mathis Heck | Fotograf" description="Fotografie-Portfolio von Mathis Heck">
	<section class="hero-split" aria-label="Einleitung">
		<div class="hero-image">
			<img class="fade-item" style="--i:0" src="/bio.png" alt="Porträt von Mathis Heck" />
		</div>
		<div class="page-intro">
			<p class="eyebrow fade-item" style="--i:1">Fotograf</p>
			<h1 class="page-title fade-item" style="--i:2">Mathis Heck</h1>
			<p class="lead fade-item" style="--i:3">
				Trier, Deutschland
			</p>
			<a class="button fade-item" style="--i:4" href="/images">Portfolio</a>
		</div>
	</section>
</BaseLayout>
