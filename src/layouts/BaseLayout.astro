---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { UMAMI_SCRIPT_URL, UMAMI_WEBSITE_ID } from 'astro:env/server';

const { title = 'Mathis Heck', description = '' } = Astro.props;
---

<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="shortcut icon" href="/favicon.svg" />
		<title>{title}</title>
		{description ? <meta name="description" content={description} /> : null}
		{UMAMI_SCRIPT_URL && UMAMI_WEBSITE_ID ? (
			<script is:inline defer src={UMAMI_SCRIPT_URL} data-website-id={UMAMI_WEBSITE_ID} data-do-not-track="true" />
		) : null}
	</head>
	<body>
		<SiteHeader />
		<main class="portfolio">
			<slot />
		</main>
	</body>
</html>
